<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The ONLY launchd job for the migrated data fleet.

  StartInterval, not StartCalendarInterval, on purpose. Calendar intervals are
  local time (so every slot shifts an hour at the DST change) and leave no
  record when the machine was powered off across a window. A plain 10-minute
  tick plus dispatcher.py's own UTC schedule table and last-run state solves
  both, and adding or retiming a job becomes a jobs.toml edit instead of a new
  plist and a launchctl reload.

  Install:
    cp com.citizenofnowhere.dispatcher.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.citizenofnowhere.dispatcher.plist
    launchctl start com.citizenofnowhere.dispatcher     # force one tick

  Check: run dispatcher.py with the status flag, and tail dispatcher.log.
  (XML comments cannot contain a double hyphen, so the flags are spelled out
  in mac-mini-jobs/README.md rather than shown here.)

  Nothing in here is machine-specific. It assumes the jobs folder is
  ~/metro-mini-jobs and takes the interpreter from config.env's PYTHON_BIN.
  Change those two things there, not here.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.citizenofnowhere.dispatcher</string>

    <!--
      No hardcoded user, and no hardcoded interpreter.

      It first shipped with /Users/ashwin and /usr/bin/python3; the mini is
      ashwindesikan and its system python is 3.9, which has no tomllib, so both
      were wrong and had to be patched by hand on the box. launchd does not
      expand variables in ProgramArguments or WorkingDirectory, so the fix is a
      shell wrapper: bash resolves HOME, and PYTHON_BIN comes from config.env,
      which is already the single source of truth for which interpreter the
      runners use. Sourcing it here means the plist can never disagree with them.

      config.env is sourced WITHOUT set -a, so its values stay shell variables
      rather than exported ones. exec does not pass unexported variables on, so
      the secrets in that file never reach the dispatcher's environment. The
      runners source it themselves, with set -a, when they need the keys.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>set -e; cd "$HOME/metro-mini-jobs"; if [ -f config.env ]; then . ./config.env; fi; exec "${PYTHON_BIN:-python3}" dispatcher.py</string>
    </array>

    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/con-dispatcher.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/con-dispatcher.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd agents get a minimal PATH; git and curl need to be findable. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
