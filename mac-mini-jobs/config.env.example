# Copy to config.env and fill in. Both jobs source this file.
# ---------------------------------------------------------------------------

# Path to the git clone of the Metro Area Project repo ON THE MINI.
# This clone must be able to push to origin/main non-interactively
# (SSH deploy key with write access, or a gh/https credential helper).
REPO_DIR="/Users/ashwin/Projects/Metro Area Project"

# Git target (defaults shown).
GIT_REMOTE="origin"
GIT_BRANCH="main"

# Python 3.12 on the mini. Point at a venv if you made one, e.g.
# PYTHON_BIN="/Users/ashwin/Projects/Metro Area Project/.venv/bin/python"
PYTHON_BIN="python3"

# Set to 1 to run the refresh WITHOUT committing/pushing (for a first test).
DRY_RUN="0"

# Where the feed monitor writes feed-monitor.log (defaults to this folder).
LOG_DIR=""

# --- Notifications ---------------------------------------------------------
# NOTIFY_PROVIDER = ntfy | pushover
NOTIFY_PROVIDER="ntfy"

# ntfy (free, no account): pick a hard-to-guess topic and subscribe to it in
# the ntfy phone/desktop app or at https://ntfy.sh/<your-topic>.
NTFY_TOPIC="con-metro-alerts-CHANGE-ME"
NTFY_SERVER="https://ntfy.sh"
# NTFY_TOKEN=""   # only if you self-host ntfy with auth

# pushover (if you prefer it): create an app at pushover.net for the token.
# PUSHOVER_TOKEN=""
# PUSHOVER_USER=""

# --- Migrated data jobs (dispatcher.py + runners/) --------------------------
# Added 2026-08-05 when business-daily, forecast, predictions and mlb-sim moved
# off GitHub Actions onto the mini. These mirror the Actions secrets of the
# workflows the mini now owns; set only the ones whose jobs you actually
# migrated. See GITHUB-TO-MINI-MIGRATION.md for the argument and the rollout.
#
# IMPORTANT: runners/predictions.sh needs numpy (metro-venv-requirements.txt
# pins numpy==2.5.1), so PYTHON_BIN above MUST point at the venv's python for
# that job, not at the system python3. The runner checks and refuses rather
# than silently taking a slow or broken path.

# business-daily: exchangerate-api.com free plan. One call per run, roughly 30
# of the 1,500 monthly requests.
EXCHANGERATE_API_KEY=""

# business-daily, forecast, predictions, mlb-sim: on-demand ISR flush against
# /api/revalidate. Same value as the Vercel env var and the GitHub Actions
# secret. Fail-open by design: leave it empty and the jobs still run, commit and
# push; the pages just refresh on their 6h ISR window instead of immediately.
REVALIDATE_SECRET=""

# Optional overrides for runners/_common.sh. Defaults shown.
# STEP_TIMEOUT="600"     # seconds, caps any single step inside a runner
# RAW_CDN_TTL="300"      # the sleep before the revalidate ping; this is the
#                        # GitHub raw CDN TTL, do not shorten it or the flush
#                        # re-caches the PREVIOUS commit's JSON for 6h
# SITE_ORIGIN="https://rankings.citizenofnowhere.org"
