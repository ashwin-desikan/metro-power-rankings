<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Screen of the Metros US box-office number-ones refresh. Runs Mon/Tue/Wed at
     06:00, 14:00, 22:00 local (9 slots) instead of a single Tuesday 14:00 — the
     weekend #1 is finalized Mon (US) and Wikipedia posts the new week Mon evening
     through Tue, so a once-a-week Tue-14:00 slot published up to ~a day late (and
     missed a week entirely if Wikipedia lagged past 14:00). The job is idempotent:
     it re-scrapes the Wikipedia page and commits [vercel skip] ONLY on a real
     change, so the extra runs are cheap no-ops and the hub goes live within a few
     hours of the new week appearing. Nothing changes Thu-Sun (data is set by then).
     Runs the repo wrapper directly through hc-run.sh for a healthchecks tile.
     Install:  cp this plist to ~/Library/LaunchAgents/ ; launchctl bootstrap it. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.citizenofnowhere.screen-number-ones</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>exec "$HOME/metro-mini-jobs/hc-run.sh" screen-number-ones /bin/bash "$HOME/Projects/Metro Area Project/mac-mini-jobs/run-screen-number-ones.sh"</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/screen-number-ones.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/screen-number-ones.err</string>
</dict>
</plist>
