<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- api-football standings/fixtures refresh, FOUR times a day: 05:00, 11:00,
     17:00 and 23:00 UTC, matching this job's `times` in jobs.toml. Each intended
     run is scheduled TWICE, at X:00 and X+1:00 LOCAL, so the pair straddles
     GMT/BST; the script's own UTC guard then runs the real job only on the
     intended UTC hour. Schedule synced from the live ~/Library/LaunchAgents copy
     2026-09-20, which had gained the 11/17/23 slots while this one still
     described a single daily run.
     Install:  cp this plist to ~/Library/LaunchAgents/ ; launchctl load it.  -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.citizenofnowhere.football-standings</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>exec /bin/bash "$HOME/Projects/Metro Area Project/mac-mini-jobs/run-football-standings.sh"</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/football-standings.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/football-standings.err</string>
</dict>
</plist>
