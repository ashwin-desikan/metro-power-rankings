<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.citizenofnowhere.feed-monitor</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/ashwindesikan/metro-mini-jobs/hc-run.sh</string>
		<string>feed-monitor</string>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>set -a; . "$HOME/metro-mini-jobs/config.env"; set +a; exec "${PYTHON_BIN:-python3}" "$HOME/metro-mini-jobs/feed_shape_monitor.py"</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/tmp/con-feed-monitor.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/con-feed-monitor.out.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>20</integer>
	</dict>
</dict>
</plist>
