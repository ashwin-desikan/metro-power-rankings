# Mission Control admin gate
# Required for /admin to work. Set the same value in Vercel project settings.
ADMIN_PASSWORD=

# Optional. Salt mixed into the session cookie hash. Defaults to a static
# string if unset; override in production for an extra layer of opacity.
ADMIN_SALT=

# Required. Server-side HMAC secret that signs the admin session cookie.
# Must be a long random string and must NOT be committed. Rotating it
# invalidates all existing admin sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# /activity gate. Deliberately a SEPARATE password/secret pair from the
# Mission Control ones above -- /activity is linked from the public
# /updates page and has no write access, so it shouldn't share a password
# with the panel that does. Set the same values in Vercel project settings.
ACTIVITY_PASSWORD=
# Generate like ADMIN_SESSION_SECRET above.
ACTIVITY_SESSION_SECRET=

# First-party page analytics (VisitBeacon -> Supabase track_visit RPC).
# Anon/publishable key only; safe to expose to the client. Leave blank to disable.
NEXT_PUBLIC_SUPABASE_URL=https://nmprqkmymrdknffwnuur.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. The service_role secret (Supabase dashboard -> Settings -> API
# -> service_role secret). NEVER prefix this with NEXT_PUBLIC_ or it ships to
# every browser. Used by app/api/v/route.ts to call the track_visit RPC,
# which is EXECUTE-restricted to service_role so the anon key can't call it
# directly. Leave blank to disable page-view analytics.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Guards POST /api/revalidate (on-demand ISR flush pinged by
# business-daily-refresh.yml after each data push). Set the SAME value in
# the Vercel project env and as a GitHub Actions secret named
# REVALIDATE_SECRET. Generate like ADMIN_SESSION_SECRET above. Leave blank
# to disable: pages then refresh on the 6-hour ISR window instead.
REVALIDATE_SECRET=

# CARTO basemap tiles: NOTHING GOES HERE.
#
# The key lives as a Cloudflare Worker secret, not as a Next env var, because
# anything the browser needs in order to call CARTO directly is readable by the
# browser. The five Leaflet maps request tiles from
# rankings.citizenofnowhere.org/tiles/* and the Worker in workers/tiles/ adds
# the key server-side. See lib/basemap.ts.
#
# To set or rotate it:
#   cd workers\tiles
#   npx wrangler secret put CARTO_KEY
