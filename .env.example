# Mission Control admin gate
# Required for /admin to work. Set the same value in Vercel project settings.
ADMIN_PASSWORD=

# Optional. Salt mixed into the session cookie hash. Defaults to a static
# string if unset; override in production for an extra layer of opacity.
ADMIN_SALT=

# Required. Server-side HMAC secret that signs the admin session cookie.
# Must be a long random string and must NOT be committed. Rotating it
# invalidates all existing admin sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
