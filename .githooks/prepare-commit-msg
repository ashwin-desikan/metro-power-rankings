#!/bin/sh
# Auto-append "[vercel skip]" to a commit message when nothing staged
# touches a build-relevant path (scripts/vercel-build-paths.txt, the same
# list scripts/vercel-ignore.sh reads).
#
# WHY THIS EXISTS: 2026-08-06, 13 real Vercel builds fired in one session
# for commits that only touched mac-mini-jobs/ and HANDOFF.md, because the
# tag was missing and vercel-ignore.sh's fallback (by design, so it can't
# miss an app change hidden behind a skipped data commit) built rather than
# guess. The tag itself was never unreliable -- rule 1 in vercel-ignore.sh
# always works. What failed was a human/agent remembering to type it, by
# hand, on every commit, all day. This removes that dependency: the hook
# runs deterministically on every `git commit`, and "did I remember" is no
# longer a question that has an answer worth checking.
#
# Enable once per clone:  git config core.hooksPath .githooks
# (this repo's convention; Windows should set the same.)

MSG_FILE="$1"
SOURCE="$2"
# git's own semantics (git-help githooks): "message" for -m/-F (how every
# commit in this repo is made), empty or "template" for an editor-composed
# message, "merge"/"squash" for those, "commit" for -c/-C/--amend (reusing
# an existing commit's own message). Only the last three carry a message
# that already has its own settled intent; skip the hook for those, and
# proceed for everything else -- BUG CAUGHT LIVE 2026-08-06: an earlier
# draft of this hook checked `[ -z "$SOURCE" ]`, which is empty ONLY for the
# rare editor-composed case, so it exited before doing anything for every
# `-m` commit, the ONLY way commits are made in this repo. Verified against
# `git help prepare-commit-msg` before shipping, not assumed.
case "$SOURCE" in merge|squash|commit) exit 0;; esac

# Already tagged on the subject line (matches vercel-ignore.sh's own check;
# a body paragraph merely discussing the tag in prose must not count, see
# that script's 2026-08-06 comment for why): nothing to do.
SUBJECT=$(head -1 "$MSG_FILE")
case "$SUBJECT" in *"[vercel skip]"*) exit 0;; esac

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 0
PATHS_FILE="$REPO_ROOT/scripts/vercel-build-paths.txt"
[ -f "$PATHS_FILE" ] || exit 0   # fail open: no list, don't touch the message

BUILD_PATHS=$(grep -v '^#' "$PATHS_FILE" | grep -v '^[[:space:]]*$')

# Nothing staged relative to HEAD? Then there is nothing for the test below to
# inspect, and `git diff --cached` returning no files would be read as "touches
# no build-relevant path" -- tagging a commit this hook has no evidence about.
#
# BUG CAUGHT LIVE 2026-08-11, by the layer-2 post-commit check, on the commit
# that fixed the refresh jobs' own skip-marker bug. `git commit --amend -F msg`
# sets SOURCE=message, NOT commit: git only says "commit" for -c/-C/--amend
# REUSING the existing message, so the guard at the top of this file does not
# fire when an amend supplies a new message with -F or -m. The amend had nothing
# newly staged, the test below saw zero files, and a commit that really did touch
# public/data silently gained the marker -- which vercel-ignore.sh rule 1 would
# then have honoured, skipping a deploy it needed.
#
# Fail open, matching the posture two lines above for a missing path list: if we
# cannot prove the commit is data-only, leave the message exactly as written. A
# normal `git commit -m` with staged work is unaffected (its cached diff is
# non-empty), and the first commit in a repo has no HEAD so it proceeds as before.
#
# RESIDUAL GAP, stated rather than papered over: this covers `--amend` with
# nothing newly staged, which is the common shape. An `--amend` that DOES stage
# something new still sees only the newly staged files, not the full amended
# tree, so it can still mis-tag. There is no reliable amend signal available
# here -- GIT_REFLOG_ACTION was probed on this repo's git and is UNSET inside
# prepare-commit-msg, and comparing against HEAD^ instead would suppress the tag
# on any data-only commit that merely follows an app commit, reintroducing the
# 13-spurious-builds failure this hook exists to prevent. That residue is
# deliberately left to layer 2: the post-commit check already flags "touches a
# build path AND is tagged" and tells the human to fix it by hand, which is
# exactly how it was caught on 2026-08-11. Two layers, each doing what it can
# actually do correctly.
if git rev-parse --verify -q HEAD >/dev/null 2>&1 && git diff --cached --quiet; then
  exit 0
fi

# Any staged file under a build-relevant path? Leave the message alone --
# this commit plausibly needs a real deploy, and auto-skipping it silently
# would be the exact class of mistake this hook exists to prevent, just
# inverted.
if git diff --cached --name-only -- $BUILD_PATHS 2>/dev/null | grep -q .; then
  exit 0
fi

# Append to the SUBJECT LINE itself, matching every real tag observed in
# this repo's history (always inline at the end of line 1, never a separate
# trailing paragraph). BUG CAUGHT LIVE 2026-08-06, by the layer-2 post-commit
# hook: an earlier draft did `printf '\n[vercel skip]\n' >> "$MSG_FILE"`,
# which puts the tag on its OWN line in the body -- invisible to
# vercel-ignore.sh's subject-line-only check (the very check added earlier
# today to close a different bug), so the auto-tag would only ever have
# "worked" by coincidence, whenever rule 4's path check happened to agree.
# Plain stream sed (no -i) so this stays portable between the mini's BSD sed
# and Windows's GNU-flavoured one -- BSD requires `-i ''`, GNU doesn't, and
# getting that wrong here would be exactly the kind of box-specific breakage
# this whole file exists to eliminate.
{
  head -1 "$MSG_FILE" | sed 's/$/ [vercel skip]/'
  tail -n +2 "$MSG_FILE"
} > "$MSG_FILE.tmp" && mv "$MSG_FILE.tmp" "$MSG_FILE"
