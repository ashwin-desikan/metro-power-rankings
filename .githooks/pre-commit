#!/bin/sh
# Pre-commit gate: a HANDOFF.md entry can't be committed without saying
# what it changed in Notion.
#
# Rule: when the staged diff ADDS lines to HANDOFF.md, at least one added
# line must start with "Notion:" or "**Notion:**" (optionally preceded by
# "- " or "### "), e.g.:
#   **Notion:** Backlog closed X; Decisions added Y
#   Notion: none (no queryable state changed)
#
# Why: HANDOFF.md is the git audit trail; the Notion databases (Backlog,
# Data sources, Decisions, Editorial calendar) are the queryable half of
# the same handoff. An entry that never says what moved in Notion is
# exactly how the two drift apart silently, which is what this check
# exists to catch.
#
# Escape hatch for emergencies: SKIP_NOTION_CHECK=1 prints a loud warning
# and lets the commit through anyway.
#
# SECOND JOB, added 2026-09-21: regenerate the two small files the Notion
# reconciler actually reads -- HANDOFF-recent.md and commits-recent.txt. It
# cannot fetch a 1 MB HANDOFF.md and cannot reach GitHub's API or commits
# page, so without these it reconciles Notion against sources it cannot see.
# Note the Notion check below can exit 0 through several paths, so that check
# is a FUNCTION and the generation runs after it either way -- appending to
# the bottom of this file would have run only on the rejection path.

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 0

# Skip on merge commits -- nothing here should block a merge.
[ -f "$REPO_ROOT/.git/MERGE_HEAD" ] && exit 0

# Fast path: the overwhelming majority of commits never touch HANDOFF.md,
# so bail immediately rather than shelling out to `git diff -U0` for every
# commit. --diff-filter=ACMR means a HANDOFF.md deletion or a rename AWAY
# from HANDOFF.md is not "touched" for this purpose -- there is nothing to
# check added lines against.
notion_line_check() {
TOUCHES_HANDOFF=$(git diff --cached --name-only --diff-filter=ACMR -- HANDOFF.md)
[ -z "$TOUCHES_HANDOFF" ] && return 0

# Added lines only (unified diff, zero context), with the "+++ b/HANDOFF.md"
# file header stripped out so it can never be mistaken for content.
ADDED=$(git diff --cached -U0 -- HANDOFF.md | grep '^+' | grep -v '^+++ ')

# Nothing actually added (e.g. a pure deletion within the file) -- nothing
# to check.
[ -z "$ADDED" ] && return 0

if printf '%s\n' "$ADDED" | grep -Eq '^\+(- |### )?(\*\*Notion:\*\*|Notion:)'; then
  return 0
fi

if [ "$SKIP_NOTION_CHECK" = "1" ]; then
  echo "" >&2
  echo "pre-commit WARNING: this HANDOFF.md entry has no Notion: line." >&2
  echo "  SKIP_NOTION_CHECK=1 is set, so the commit is allowed through" >&2
  echo "  anyway. This is an emergency escape hatch, not normal practice --" >&2
  echo "  go back and add the Notion line as soon as you can." >&2
  echo "" >&2
  return 0
fi

echo "" >&2
echo "pre-commit REJECTED: this commit adds lines to HANDOFF.md but none" >&2
echo "  of them say what changed in Notion." >&2
echo "" >&2
echo "  Add a line starting with 'Notion:' or '**Notion:**', e.g.:" >&2
echo "    **Notion:** Backlog closed X; Decisions added Y" >&2
echo "    Notion: none (no queryable state changed)" >&2
echo "" >&2
echo "  See the Notion operating contract page and CLAUDE.md's" >&2
echo "  'Notion is the source of truth' section." >&2
echo "" >&2
echo "  Emergency override: SKIP_NOTION_CHECK=1 git commit ..." >&2
echo "" >&2
return 1
}

notion_line_check || exit 1

# --- generated inputs for the Notion reconciler ------------------------------
# Both files are GENERATED and staged automatically; edit HANDOFF.md, never
# these. Kept in the repo rather than produced on demand because the thing that
# reads them cannot run scripts -- it can only read files it is handed.

# HANDOFF-recent.md, only when HANDOFF.md is part of this commit. Reads the
# STAGED blob, so what gets summarised is exactly what is being committed.
if [ -n "$(git diff --cached --name-only --diff-filter=ACMR -- HANDOFF.md)" ]; then
  if ! git show :HANDOFF.md | python3 "$REPO_ROOT/scripts/handoff_recent.py" --stdin --days 7; then
    echo "" >&2
    echo "pre-commit REJECTED: scripts/handoff_recent.py failed on the staged" >&2
    echo "  HANDOFF.md, so HANDOFF-recent.md would go stale without anyone" >&2
    echo "  noticing. Fix the error above and commit again." >&2
    echo "" >&2
    exit 1
  fi
  git add "$REPO_ROOT/HANDOFF-recent.md"
fi

# commits-recent.txt every time, since any commit changes the log. Two families
# of bot commit are excluded, because they are the bulk of the history and say
# nothing a human reconciling Notion needs: `Auto:` (the refresh bots) and
# `data: refresh-schedule` (the dispatcher rewriting its own schedule export,
# which lands several times an hour). Widened 2026-09-21 after measuring the
# first version: `^Auto:` alone left 56 of 80 lines as refresh-schedule noise,
# so the file the reconciler reads was about 70 percent filler. Multiple
# --grep are OR'd and --invert-grep then inverts the lot, so this excludes a
# commit matching EITHER pattern.
#
# NOTE it is generated from HEAD, so it always lags by exactly this commit --
# inherent to a pre-commit hook, and harmless for its purpose, which is "what
# has been going on lately".
if git log --no-merges --invert-grep --grep='^Auto:' --grep='^data: refresh-schedule' \
     --date=iso-strict --pretty='%ad  %h  %s' -n 80 > "$REPO_ROOT/commits-recent.txt"; then
  git add "$REPO_ROOT/commits-recent.txt"
else
  echo "pre-commit WARNING: could not regenerate commits-recent.txt" >&2
fi

exit 0
