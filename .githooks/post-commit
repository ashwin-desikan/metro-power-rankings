#!/bin/sh
# Independent re-check, right after every commit, that prepare-commit-msg's
# decision was actually correct -- a second, separate mechanism rather than
# trusting the first one blindly. Detect-only: never rewrites the commit
# (amending is its own risk), just prints a loud, impossible-to-miss line.
#
# Layer 2 of the 2026-08-06 fix (see .githooks/prepare-commit-msg and
# scripts/vercel-ignore.sh for layer 1 and the incident that caused this).

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 0
PATHS_FILE="$REPO_ROOT/scripts/vercel-build-paths.txt"
[ -f "$PATHS_FILE" ] || exit 0

BUILD_PATHS=$(grep -v '^#' "$PATHS_FILE" | grep -v '^[[:space:]]*$')
SUBJECT=$(git log -1 --pretty=%s)
TOUCHES_BUILD=0
git diff --quiet HEAD~1 HEAD -- $BUILD_PATHS 2>/dev/null || TOUCHES_BUILD=1
HAS_TAG=0
case "$SUBJECT" in *"[vercel skip]"*) HAS_TAG=1;; esac
HAS_DEPLOY_NOW=0
case "$SUBJECT" in *"[deploy-now]"*) HAS_DEPLOY_NOW=1;; esac

if [ "$HAS_DEPLOY_NOW" = 1 ] && [ "$HAS_TAG" = 1 ]; then
  # Both tags on one subject. vercel-ignore.sh tests [vercel skip] FIRST and
  # exits before it reaches [deploy-now], so the skip wins and the override is
  # dead weight -- the build the author asked for will not happen, and nothing
  # will say so, because a skip is a perfectly normal outcome to the guard.
  # Worth stopping loudly: this is the one combination that silently does the
  # opposite of what it reads like.
  #
  # ⚠️ It cannot tell a DIRECTIVE from PROSE. A subject that merely discusses
  # both tags trips it -- the commit that introduced this check did exactly
  # that, immediately, being titled "...teach both about [deploy-now]..." while
  # carrying a real [vercel skip]. vercel-ignore.sh has the same exposure and
  # the same answer (its 2026-08-06 comment): the tags are matched literally,
  # anywhere on the subject line, because anything cleverer is guesswork. So
  # when WRITING ABOUT a tag in a subject, drop the brackets -- "deploy-now",
  # not "[deploy-now]". The behaviour here was still correct (skip wins, no
  # build spent); only the warning was noise.
  echo "post-commit CHECK: MISMATCH -- this commit carries BOTH [deploy-now]" >&2
  echo "  and [vercel skip]. vercel-ignore.sh checks skip first, so the skip" >&2
  echo "  WINS and [deploy-now] does nothing. Drop one: keep [vercel skip] if" >&2
  echo "  this should not deploy, or drop it if it should." >&2
elif [ "$TOUCHES_BUILD" = 1 ] && [ "$HAS_TAG" = 1 ]; then
  # vercel-ignore.sh's own comment: "public/data STAYS IN, and that is
  # deliberate... The ISR-backed files (business, mlb-sim, the espn
  # snapshots, the football live bundles) are the exception, not the rule,
  # and are already handled by rule 1, since their commits carry the
  # marker." So for these specific jobs, touching public/ AND carrying the
  # tag is not a mistake, it is the documented design -- and narrowing
  # vercel-build-paths.txt itself to exclude them was tried and reverted
  # (see that file's history): it can't tell an ISR-backed file from one of
  # the 313 readFileSync build-time reads without a real per-file audit
  # nobody has done, so the path list has to stay broad.
  #
  # What CAN be checked cheaply and safely, without touching that list: does
  # THIS commit look like one of the known automated data-refresh jobs --
  # authored by one of this repo's fixed bot identities, AND its
  # build-relevant diff scoped to `public` only, never app/lib/proxy.ts/
  # next.config.ts/etc, which no automated job here ever touches and a real
  # app change would. Both holding is exactly the exception vercel-ignore.sh
  # already documents, so suppress the false alarm for it too. A HUMAN
  # commit (any other author) still gets the full warning below -- that is
  # where the two real bugs (2026-08-06, 2026-08-11) were actually caught,
  # and neither was bot-authored.
  #
  # ⚠️ UPDATED 2026-09-22. Suppressing the alarm was right; calling every one
  # of these "the documented ISR exception" was NOT. Most of public/data is
  # read with readFileSync at build time (CLAUDE.md: 313 sites; the ISR-backed
  # files are the minority). A commit correcting eight election dates printed
  # "the documented ISR exception" while those dates were nowhere near the
  # live site, because *-elections.json has no raw fallback and no revalidate.
  # A session trusting that line would believe the site had been updated.
  #
  # The old comment here said the two could not be told apart "without a real
  # per-file audit nobody has done". They can: an ISR-backed file is exactly
  # one fetched from raw.githubusercontent.com at request time, and that list
  # now lives in scripts/isr-backed-paths.txt with the greps that re-derive
  # it. So both arms below still say OK -- neither is a mistake -- but they
  # now say something TRUE about whether the change is on the site yet.
  AUTHOR_EMAIL=$(git log -1 --pretty=%ae)
  KNOWN_BOT=0
  case "$AUTHOR_EMAIL" in
    metro-mini-bot@users.noreply.github.com|mac-mini-claude@users.noreply.github.com|"github-actions[bot]@users.noreply.github.com") KNOWN_BOT=1;;
  esac
  NON_PUBLIC_PATHS=$(printf '%s\n' "$BUILD_PATHS" | grep -vx 'public')
  PUBLIC_ONLY=1
  git diff --quiet HEAD~1 HEAD -- $NON_PUBLIC_PATHS 2>/dev/null || PUBLIC_ONLY=0

  if [ "$KNOWN_BOT" = 1 ] && [ "$PUBLIC_ONLY" = 1 ]; then
    # Is every public/data file in this commit one the site can refresh
    # without a build? Anything outside the list -- including any public/
    # file that is not under public/data at all -- means no.
    ISR_FILE="$REPO_ROOT/scripts/isr-backed-paths.txt"
    NEEDS_BUILD=""
    if [ -f "$ISR_FILE" ]; then
      for f in $(git diff --name-only HEAD~1 HEAD -- public); do
        case "$f" in
          public/data/*) rel=${f#public/data/} ;;
          *) NEEDS_BUILD="$NEEDS_BUILD $f"; continue ;;
        esac
        covered=0
        while IFS= read -r p; do
          case "$p" in ''|\#*) continue ;; esac
          case "$rel" in "$p"|"$p"/*) covered=1; break ;; esac
        done < "$ISR_FILE"
        [ "$covered" = 1 ] || NEEDS_BUILD="$NEEDS_BUILD $f"
      done
    else
      NEEDS_BUILD=" (scripts/isr-backed-paths.txt missing)"
    fi

    if [ -z "$NEEDS_BUILD" ]; then
      echo "post-commit CHECK: OK (touches_build=1 tagged=1, automated data" \
           "commit, every file ISR-backed -- live within its revalidate" \
           "window, no build needed)"
    else
      # Not a mismatch: the skip is still what was wanted. But the change is
      # in the repo and NOT on the site, and saying so is the whole point.
      # Deliberately "not on the list" rather than "not ISR-backed": the list
      # is conservative and knowingly incomplete, and claiming more than it
      # knows is how the message it replaces went wrong in the first place.
      echo "post-commit CHECK: OK, BUT PROBABLY NOT LIVE (touches_build=1" \
           "tagged=1, automated data commit). These files are not on the" \
           "ISR-backed list, so unless they are, the change is in the repo" \
           "and reaches the site only when something next builds:"
      for f in $NEEDS_BUILD; do echo "    $f"; done
      echo "  Fine if a build is coming. If they are needed live now, push an" \
           "empty commit whose SUBJECT carries [deploy-now]. If they ARE" \
           "served from GitHub raw at request time, add them to" \
           "scripts/isr-backed-paths.txt (read its warning about which way to" \
           "err) and this note will stop."
    fi
  else
    echo "post-commit CHECK: MISMATCH -- this commit touches a build-relevant" >&2
    echo "  path AND is tagged [vercel skip]. That means Vercel will SKIP a" >&2
    echo "  deploy this commit may actually need. Not auto-fixed (amending is" >&2
    echo "  its own risk) -- if the tag is wrong, fix it by hand: git commit" >&2
    echo "  --amend, or a follow-up commit without the tag." >&2
  fi
elif [ "$TOUCHES_BUILD" = 0 ] && [ "$HAS_TAG" = 0 ] && [ "$HAS_DEPLOY_NOW" = 1 ]; then
  # A [deploy-now] trigger is MEANT to touch nothing: its whole job is to carry
  # the tag so vercel-ignore.sh builds the tree at HEAD, past the same-day cap.
  # Before this arm existed the hook read it as the 2026-08-06 failure mode and
  # warned on a commit that was doing exactly what was asked (2026-09-11), which
  # is how a real guard starts getting ignored.
  echo "post-commit CHECK: OK (touches_build=0, [deploy-now] trigger -- builds" \
       "past the same-day cap by design)"
elif [ "$TOUCHES_BUILD" = 0 ] && [ "$HAS_TAG" = 0 ]; then
  echo "post-commit CHECK: MISMATCH -- this commit touches nothing build-" >&2
  echo "  relevant but has no [vercel skip] tag. This is the 2026-08-06" >&2
  echo "  failure mode (13 wasted builds). prepare-commit-msg should have" >&2
  echo "  caught this -- check core.hooksPath is set (git config" >&2
  echo "  core.hooksPath) and the hook is executable." >&2
else
  echo "post-commit CHECK: OK (touches_build=$TOUCHES_BUILD tagged=$HAS_TAG)"
fi
