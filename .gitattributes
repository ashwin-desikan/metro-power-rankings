*.mjs text eol=lf
*.sh text eol=lf

# Generated by .githooks/pre-commit on EVERY commit, on every machine. Two machines that
# commit between pulls both rewrite the same top lines, so a plain rebase conflicts
# (Windows box, 2026-09-21), and on the mini a conflict inside commit_paths'
# `git pull --rebase --autostash` retry loop would leave the clone mid-rebase.
# union keeps both sides' lines and never conflicts. The merged content does not need
# to be right: the hook rewrites the file on the next commit.
commits-recent.txt merge=union
HANDOFF-recent.md merge=union
