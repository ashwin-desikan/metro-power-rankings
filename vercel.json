{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sh scripts/vercel-ignore.sh",
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=2592000"
        }
      ]
    }
  ]
}
