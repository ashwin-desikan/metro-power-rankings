 "eras": [
  {
   "key": "union",
   "label": "The Union's whites-only parliament",
   "span": "1910–1943",
   "blurb": "From Union in 1910, the House of Assembly was elected almost entirely by white voters — a qualified Cape franchise for Black and Coloured voters was progressively stripped away. Politics turned on Boer–British reconciliation, Hertzog's nationalism, the 1933 fusion of Hertzog and Smuts, and the war split of 1939."
  },
  {
   "key": "apartheid",
   "label": "The apartheid parliament",
   "span": "1948–1989",
   "blurb": "D. F. Malan's National Party won the whites-only 1948 election on the apartheid platform and never lost again, entrenching minority rule for four decades. The last Black voters were removed from the rolls, the Republic left the Commonwealth in 1961, and by the tricameral 1980s the white chamber governed a country in revolt."
  },
  {
   "key": "democracy",
   "label": "The democratic era",
   "span": "1994–2024",
   "blurb": "The 1994 election was the first in which every adult South African could vote — queues stretched for days and Nelson Mandela's ANC won just short of two-thirds. Three decades of ANC dominance followed, until 2024 broke the majority and produced a government of national unity."
  }
 ],
