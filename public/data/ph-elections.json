 "eras": [
  {
   "key": "commonwealth",
   "label": "The Commonwealth",
   "span": "1935–1946",
   "blurb": "Elected under American sovereignty from 1935, with independence promised for 1946. Quezon won twice; the 1943 election was held under Japanese occupation by a hand-picked assembly and is listed here as what it was."
  },
  {
   "key": "third",
   "label": "The Third Republic",
   "span": "1949–1969",
   "blurb": "A two-party system of Nacionalistas and Liberals that was genuinely competitive and genuinely violent, with turnout above 75% and a habit of turning out incumbents. Magsaysay, Macapagal and Marcos each took the presidency from a sitting party."
  },
  {
   "key": "marcos",
   "label": "Martial law",
   "span": "1972–1985",
   "blurb": "Marcos declared martial law in 1972 rather than leave office, held a referendum-style election in 1981 that the opposition boycotted, and called a snap election in 1986 that he claimed to have won. The count was so brazen that the computer operators walked out on television."
  },
  {
   "key": "fifth",
   "label": "The Fifth Republic",
   "span": "1992–",
   "blurb": "People Power removed Marcos and the 1987 constitution gave the president a single six-year term, which is why every election here has an open field and why pluralities of 40% or less have repeatedly been enough to win. Marcos's son took 58.8% in 2022, the largest majority since his father's."
  }
 ],
