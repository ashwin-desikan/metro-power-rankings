 "presEras": [
  {
   "key": "founding",
   "label": "The founding elections",
   "span": "1991–1999",
   "blurb": "Ukraine elected its first president on the same day it voted for independence, 1 December 1991. The Kravchuk and Kuchma years established the pattern of fiercely contested two-round races decided between east and west — and of incumbents losing, which has happened more often in Ukraine than almost anywhere in the post-Soviet world."
  },
  {
   "key": "orange",
   "label": "The Orange decade",
   "span": "2004–2010",
   "blurb": "The falsified runoff of November 2004 brought a million people onto the Maidan, and the re-run it forced put Viktor Yushchenko in office. Six years later his rival Viktor Yanukovych won the rematch cleanly — the revolution's promise unfulfilled, but the habit of real elections intact."
  },
  {
   "key": "wartime",
   "label": "Elections at war",
   "span": "2014–2019",
   "blurb": "Both post-Maidan presidential elections were held with Crimea annexed and a war burning in the Donbas. Petro Poroshenko won outright in 2014; five years later voters replaced him with a television comedian in the largest landslide in Ukrainian history. The next election awaits the end of martial law."
  }
 ],
 "legEras": [
  {
   "key": "post-soviet",
   "label": "The post-Soviet Rada",
   "span": "1994–2002",
   "blurb": "The first Verkhovna Rada elections ran on majoritarian and then mixed rules, producing fragmented parliaments where independents and the revived Communist Party loomed large and governments were made in the corridors rather than at the ballot box."
  },
  {
   "key": "orange",
   "label": "Orange and blue",
   "span": "2006–2012",
   "blurb": "Full proportional voting from 2006 turned Rada elections into national duels between the Orange camp and Yanukovych's Party of Regions — including the 2007 snap election that briefly returned Yulia Tymoshenko to the premiership, and the tilted 2012 vote held with her in prison."
  },
  {
   "key": "wartime",
   "label": "The wartime Rada",
   "span": "2014–2019",
   "blurb": "The post-Maidan parliaments were elected without Crimea and much of the Donbas. In 2019 Volodymyr Zelenskyy's brand-new Servant of the People party won the first single-party majority in Ukraine's independent history. The Rada elected in 2019 continues to sit under martial law."
  }
 ],
