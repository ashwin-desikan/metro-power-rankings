  "_meta": {
    "title": "Motorsport world championships outside Formula 1",
    "purpose": "Feeds the Zone Zero Cup motorsport recognition bonus. Formula 1 is not listed here; it is read live from public/data/f1/data.json.",
    "test": "Any top-tier championship with a season-long drivers' title is credited. How international the field is sets the weight, not whether the series is admitted. An earlier draft excluded a series whose champions were all one nationality, which put NASCAR among the national sports; Ashwin overruled it on 2026-09-04 and NASCAR is here with a weight that reflects a domestic field.",
    "excluded": {
      "World Endurance Championship / Le Mans": "Titles are won by two- and three-driver crews of mixed nationality. Attribution to one nation is not merely uncertain, it is ambiguous by construction.",
      "Isle of Man TT / Dakar": "Event wins, not a championship. No season-long title to decay.",
      "Junior single-seaters (F2, F3, Moto2, Moto3)": "Feeder series. Crediting them would count the same driver twice on the way up."
    },
    "weights": "Weight reflects how deep and how international the field is, and whether the series holds world championship status. Formula 1 is the 1.00 anchor.",
    "window": "1990 onward. With an 8-year half-life a 1990 title is already worth 0.04 of a current one, so earlier seasons cannot move a ranking.",
    "asOf": "2026-09-04",
