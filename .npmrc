; Always install devDependencies, even when NODE_ENV=production.
; Some dev/build machines set NODE_ENV=production globally, which makes a plain
; `npm install` prune devDependencies (TypeScript types, vitest, etc.), breaking
; local typecheck and tests. Pinning include=dev keeps the dev tooling installed
; on every machine and fresh clone without needing an --include=dev flag.
; Harmless on Vercel, which already installs devDependencies during the build.
include=dev
